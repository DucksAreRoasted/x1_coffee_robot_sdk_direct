<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
      <!-- 只走机器人这张有线网。每台机器只用自己有的那个地址。 -->
      <interfaceWhiteList>
        <address>192.168.2.1</address>
        <address>192.168.2.230</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>192.168.2.1</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.2.230</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
  <!-- 关掉共享内存。上电进程是 root 时，桌面用户的 RViz 打不开 root 的段，/robot_description 和 /tf_static 都收不到。 -->
  <data_writer profile_name="no_data_sharing_writer" is_default_profile="true">
    <qos>
      <data_sharing>
        <kind>OFF</kind>
      </data_sharing>
    </qos>
  </data_writer>
  <data_reader profile_name="no_data_sharing_reader" is_default_profile="true">
    <qos>
      <data_sharing>
        <kind>OFF</kind>
      </data_sharing>
    </qos>
  </data_reader>
</profiles>
