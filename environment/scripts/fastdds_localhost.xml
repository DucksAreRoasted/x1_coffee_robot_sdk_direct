<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- 2026-11-12：不再用自定义 UDP 传输。
       原因：useBuiltinTransports=false 会让同一台机器上的所有参与者共用同一个 UDP 端口，
       服务请求是单播，可能被投递给错误的进程。表现就是「图里能看到节点和服务，
       但 spawn_controllers / 键盘程序永远等不到服务」。
       改用内置传输后，每个参与者按域号分到独立端口；同用户进程走 SHM，跨机走 UDP。
       发现仍用下面两个地址做初始对端，避免跑到无关网卡上。 -->
  <participant profile_name="udp_participant" is_default_profile="true">
    <rtps>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>192.168.2.1</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.2.230</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
  <!-- 关掉数据共享（不是 SHM 传输）：root 写的段桌面用户打不开，/robot_description 和
       /tf_static 会收不到。 -->
  <data_writer profile_name="no_data_sharing_writer" is_default_profile="true">
    <qos>
      <data_sharing>
        <kind>OFF</kind>
      </data_sharing>
    </qos>
  </data_writer>
  <data_reader profile_name="no_data_sharing_reader" is_default_profile="true">
    <qos>
      <data_sharing>
        <kind>OFF</kind>
      </data_sharing>
    </qos>
  </data_reader>
</profiles>
