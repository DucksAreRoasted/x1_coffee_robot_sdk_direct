<?xml version="1.0"?>
<package format="3">
  <name>x1_coffee_integration</name>
  <version>0.3.0</version>
  <description>Integration configuration for Coffee MoveIt and OpenArm-compatible teleoperation.</description>
  <maintainer email="sdk-maintainers@example.com">X1 SDK Maintainers</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
